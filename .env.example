# VaaniDesk environment template
# Copy to `.env` and fill values. Never commit real secrets.
# Never hardcode PUCH_APPLICATION_KEY, PUCH_PHONE_NUMBER, or resume Markdown contents.

# Frontend package manager: npm (lockfile: package-lock.json)
# -----------------------------------------------------------------------------

APP_NAME=VaaniDesk
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
# Versioned business APIs live under this prefix. /health, /ready, /mcp stay unversioned.
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000
TRUSTED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO
LOG_FORMAT=json

# -----------------------------------------------------------------------------
# HTTP
# -----------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Database (PostgreSQL + pgvector)
# -----------------------------------------------------------------------------
POSTGRES_USER=vaanidesk
POSTGRES_PASSWORD=vaanidesk_dev_password
POSTGRES_DB=vaanidesk
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://vaanidesk:vaanidesk_dev_password@localhost:5432/vaanidesk

# -----------------------------------------------------------------------------
# Redis
# Optional caches may degrade if Redis is down.
# Confirmation tokens, replay protection, sensitive-action AuthZ, and security
# rate limits MUST fail closed when Redis is unavailable.
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_REQUIRED_FOR_SECURITY=true

# -----------------------------------------------------------------------------
# AI providers — default mock works without API keys
# LLM_PROVIDER=mock | openai | anthropic
# EMBEDDING_PROVIDER=mock uses deterministic lexical n-gram hashing for offline
# tests only — not production semantic embeddings.
# -----------------------------------------------------------------------------
LLM_PROVIDER=mock
EMBEDDING_PROVIDER=mock
STT_PROVIDER=mock
TTS_PROVIDER=mock
VISION_PROVIDER=mock

OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-3-5-haiku-latest

# Optional cost estimation (USD per 1M tokens) for observability
COST_INPUT_PER_1M=0.15
COST_OUTPUT_PER_1M=0.60

# -----------------------------------------------------------------------------
# Agent / safety
# -----------------------------------------------------------------------------
AGENT_CONFIDENCE_ESCALATE_THRESHOLD=0.45
RAG_MIN_RETRIEVAL_CONFIDENCE=0.30
MAX_KNOWLEDGE_UPLOAD_BYTES=512000
RATE_LIMIT_PER_MINUTE=60
MAX_REQUEST_BODY_BYTES=2097152
MAX_UPLOAD_BYTES=10485760
MAX_AUDIO_DURATION_SECONDS=120
CONFIRMATION_TOKEN_TTL_SECONDS=600
IDEMPOTENCY_RECORD_TTL_DAYS=30
PROVIDER_TIMEOUT_SECONDS=30
PROVIDER_MAX_RETRIES=2

# -----------------------------------------------------------------------------
# Object storage abstraction
# STORAGE_BACKEND=local | s3
# -----------------------------------------------------------------------------
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./uploads
# S3_ENDPOINT_URL=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=

# -----------------------------------------------------------------------------
# WhatsApp Cloud API (optional). Without these, only the labeled simulator runs.
# -----------------------------------------------------------------------------
WHATSAPP_ENABLED=false
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=vaanidesk-verify-change-me
WHATSAPP_APP_SECRET=

# -----------------------------------------------------------------------------
# MCP server (MCP Python SDK v2 + Streamable HTTP at /mcp)
# -----------------------------------------------------------------------------
MCP_HOST=0.0.0.0
MCP_PORT=8085
MCP_PUBLIC_URL=http://localhost:8085
# Optional generic bearer for non-Puch clients; prefer Puch vars for Puch.
MCP_BEARER_TOKEN=change-me-mcp-bearer-token
# Reserved for future OAuth
MCP_OAUTH_ENABLED=false

# -----------------------------------------------------------------------------
# Puch application MCP (compatibility layer)
# Never hardcode these values or the resume file contents in source.
# validate → returns PUCH_PHONE_NUMBER
# resume   → returns Markdown loaded from RESUME_MARKDOWN_PATH
# -----------------------------------------------------------------------------
PUCH_APPLICATION_KEY=change-me-puch-application-key
PUCH_PHONE_NUMBER=
RESUME_MARKDOWN_PATH=./sample_data/resume/RESUME.md

# -----------------------------------------------------------------------------
# Phase 5 — Omnichannel
# -----------------------------------------------------------------------------
CHANNELS_ENABLED=true
EMAIL_ADAPTER_ENABLED=true
WHATSAPP_ENABLED=false
CHANNEL_WEBHOOK_MAX_BYTES=1048576
CHANNEL_SIGNATURE_TOLERANCE_SECONDS=300
CHANNEL_LINK_CHALLENGE_TTL_SECONDS=600
CHANNEL_EXTERNAL_CONFIRM_TTL_SECONDS=600
CHANNEL_ATTACHMENT_MAX_BYTES=10485760
CHANNEL_OUTBOX_MAX_ATTEMPTS=5
CHANNEL_HMAC_SECRET=dev-hmac-secret-not-for-production

# -----------------------------------------------------------------------------
# Phase 4 — Voice / audio (mock STT/TTS by default)
# -----------------------------------------------------------------------------
VOICE_ENABLED=true
VOICE_AUTO_SUBMIT_ENABLED=true
AUDIO_STORAGE_DIR=./uploads/audio
AUDIO_RETENTION_HOURS=72
AUDIO_MAX_SIZE_BYTES=10485760
AUDIO_MAX_DURATION_SECONDS=120
AUDIO_ALLOWED_FORMATS=wav,mp3,webm,m4a
AUDIO_PROCESSING_TIMEOUT_SECONDS=30
STT_MIN_AUTO_SUBMIT_CONFIDENCE=0.85
VOICE_UPLOADS_PER_MINUTE=20
VOICE_BYTES_PER_HOUR=52428800
STT_REQUESTS_PER_MINUTE=30
TTS_REQUESTS_PER_MINUTE=30
VOICE_MAX_CONCURRENT_JOBS=4

# -----------------------------------------------------------------------------
# Phase 6 — Evaluations / observability
# -----------------------------------------------------------------------------
OTEL_ENABLED=false
OTEL_EXPORTER=console
OTEL_SERVICE_NAME=vaanidesk-backend
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
METRICS_ENABLED=true
EVAL_DEFAULT_PROVIDER=mock
EVAL_DEFAULT_SEED=42
EVAL_DEFAULT_TIMEOUT=60
EVAL_MAX_CONCURRENCY=8
ALERT_ERROR_RATE_THRESHOLD=0.10
ALERT_LATENCY_P95_THRESHOLD_MS=5000.0
ALERT_PROVIDER_FAILURE_THRESHOLD=0.50
ALERT_EVAL_WINDOW_SECONDS=300

# -----------------------------------------------------------------------------
# Demo / seed
# -----------------------------------------------------------------------------
SEED_ON_STARTUP=false
DEMO_MODE=true
# Knowledge corpus directory (must contain manifest.json).
# Compose: /sample_data/policies with ./sample_data mounted at /sample_data:ro
# Host: leave unset to use <repository-root>/sample_data/policies
# KNOWLEDGE_SEED_DIR=
