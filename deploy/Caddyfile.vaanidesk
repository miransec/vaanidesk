# System Caddy site block for VaaniDesk portfolio demo.
# Merged into /etc/caddy/Caddyfile on the VPS (do not run a nested Caddy container).

vaanidesk.muhammadmiran.com {
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Permissions-Policy "accelerometer=(), autoplay=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
		-Server
	}

	# Defense in depth — Swagger/OpenAPI stay off the public demo
	handle /docs* {
		respond 404
	}
	handle /redoc* {
		respond 404
	}
	handle /openapi.json {
		respond 404
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:18000 {
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
			header_up X-Real-IP {remote_host}
		}
	}

	handle /health {
		reverse_proxy 127.0.0.1:18000
	}

	handle /ready {
		reverse_proxy 127.0.0.1:18000
	}

	handle {
		reverse_proxy 127.0.0.1:13000 {
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
			header_up X-Real-IP {remote_host}
		}
	}

	request_body {
		max_size 10MB
	}
}
