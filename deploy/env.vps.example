# VaaniDesk VPS demo environment template
# Copy to `.env.vps` on the server and fill secrets. Never commit `.env.vps`.

APP_ENV=production
DEBUG=false

POSTGRES_USER=vaanidesk
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
POSTGRES_DB=vaanidesk
REDIS_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

SECRET_KEY=REPLACE_WITH_64_CHAR_SECRET
JWT_SECRET_KEY=REPLACE_WITH_64_CHAR_SECRET
PASSWORD_PEPPER=REPLACE_WITH_32_CHAR_SECRET

CORS_ORIGINS=https://vaanidesk.muhammadmiran.com
TRUSTED_HOSTS=vaanidesk.muhammadmiran.com,127.0.0.1,localhost
FRONTEND_URL=https://vaanidesk.muhammadmiran.com
PUBLIC_API_URL=https://vaanidesk.muhammadmiran.com

LLM_PROVIDER=mock
EMBEDDING_PROVIDER=mock
STT_PROVIDER=mock
TTS_PROVIDER=mock
VISION_PROVIDER=mock
DEMO_MODE=true
